<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ClickerMain.uss" />
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement class="top-bar">
            <ui:VisualElement class="brand-block">
                <ui:Label text="EMBER FORGE" class="eyebrow" />
                <ui:Label text="Crystal Workshop" class="title" />
            </ui:VisualElement>
            <ui:VisualElement class="currency-pill">
                <ui:Label text="G" class="currency-icon" />
                <ui:Label name="currency-label" text="1,250" class="currency-value" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="content">
            <ui:VisualElement class="stage panel">
                <ui:Label text="ARCANE CORE" class="section-label" />
                <ui:Label name="per-second-label" text="+12 / sec" class="income-label" />
                <ui:Button name="click-target" class="click-target">
                    <ui:VisualElement class="crystal-image" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label text="TAP TO HARVEST" class="tap-hint" />
                <ui:Label name="per-tap-label" text="+5 each tap" class="tap-value" />
            </ui:VisualElement>

            <ui:VisualElement class="upgrade-section">
                <ui:VisualElement class="section-heading">
                    <ui:Label text="UPGRADES" class="section-title" />
                    <ui:Label text="Build your engine" class="section-caption" />
                </ui:VisualElement>
                <ui:Button name="tap-upgrade" class="upgrade-card">
                    <ui:Label text="TAP" class="upgrade-icon coral" />
                    <ui:VisualElement class="upgrade-copy">
                        <ui:Label text="Sharper Tools" class="upgrade-name" />
                        <ui:Label name="tap-level" text="Level 1 | +5 per tap" class="upgrade-detail" />
                    </ui:VisualElement>
                    <ui:Label name="tap-cost" text="100 G" class="cost-pill" />
                </ui:Button>
                <ui:Button name="idle-upgrade" class="upgrade-card">
                    <ui:Label text="AUTO" class="upgrade-icon violet" />
                    <ui:VisualElement class="upgrade-copy">
                        <ui:Label text="Auto Collector" class="upgrade-name" />
                        <ui:Label name="idle-level" text="Level 1 | +12 per sec" class="upgrade-detail" />
                    </ui:VisualElement>
                    <ui:Label name="idle-cost" text="250 G" class="cost-pill" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="bottom-nav">
            <ui:Button text="FORGE" class="nav-button active" />
            <ui:Button text="ITEMS" class="nav-button" />
            <ui:Button text="SETTINGS" class="nav-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
